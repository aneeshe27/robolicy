<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="panda">
  <xacro:arg name="robot_name" default="panda"/>
  <xacro:arg name="load_gripper" default="true"/>
  <xacro:arg name="load_gazebo" default="false"/>
  <xacro:arg name="use_gazebo_control" default="false"/>
  <xacro:arg name="connected_to" default=""/>

  <xacro:include filename="$(find franka_panda_description)/robots/panda_arm.xacro"/>

  <xacro:if value="$(arg load_gripper)">
    <xacro:include filename="$(find franka_panda_description)/robots/hand.xacro"/>
    <xacro:hand ns="panda" rpy="0 0 ${-pi/4}" connected_to="panda_link8"/>
  </xacro:if>

  <xacro:if value="$(arg load_gazebo)">
    <xacro:include filename="$(find franka_panda_description)/robots/panda.gazebo.xacro"/>
    <xacro:include filename="$(find franka_panda_description)/robots/panda.transmission.xacro"/>

    <xacro:panda_arm in_gazebo="true" connected_to="$(arg connected_to)"/>
    <xacro:panda_gazebo robot_name="$(arg robot_name)" load_gripper="$(arg load_gripper)"/>
    <xacro:panda_transmission robot_name="$(arg robot_name)" load_gripper="$(arg load_gripper)" use_gazebo_control="$(arg use_gazebo_control)"/>
  </xacro:if>

  <xacro:unless value="$(arg load_gazebo)">
    <xacro:panda_arm />
  </xacro:unless>

  <link name="panda_wrist_camera_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.01"/>
      <inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.02 0.02 0.02"/>
      </geometry>
      <material name="wrist_camera_gray">
        <color rgba="0.2 0.2 0.2 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.02 0.02 0.02"/>
      </geometry>
    </collision>
  </link>

  <joint name="panda_wrist_camera_joint" type="fixed">
    <parent link="panda_hand"/>
    <child link="panda_wrist_camera_link"/>
    <!--
      Camera optical axis (+X of the sensor link) points along panda_hand's
      +Z (i.e. out toward the fingertips). The extra roll of pi rotates the
      image 180 deg around the optical axis so "up" in the wrist image is
      the back of the hand rather than the palm side - previously the feed
      came out upside down.
    -->
    <origin xyz="0.08 0.0 0.06" rpy="${pi} ${-pi/2} 0"/>
  </joint>

  <gazebo reference="panda_wrist_camera_link">
    <sensor name="panda_wrist_rgb" type="camera">
      <always_on>true</always_on>
      <visualize>false</visualize>
      <update_rate>20</update_rate>
      <camera>
        <horizontal_fov>1.35</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.02</near>
          <far>2.0</far>
        </clip>
      </camera>
      <plugin name="panda_wrist_camera_plugin" filename="libgazebo_ros_camera.so">
        <alwaysOn>true</alwaysOn>
        <updateRate>0.0</updateRate>
        <cameraName>wrist_camera</cameraName>
        <imageTopicName>/wrist_camera/color/image_raw</imageTopicName>
        <cameraInfoTopicName>/wrist_camera/color/camera_info</cameraInfoTopicName>
        <frameName>panda_wrist_camera_link</frameName>
      </plugin>
    </sensor>
  </gazebo>
</robot>
