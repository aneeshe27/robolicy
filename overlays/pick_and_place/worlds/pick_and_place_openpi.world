<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="openpi_pick_and_place">
    <include>
      <uri>model://sun</uri>
    </include>

    <include>
      <uri>model://ground_plane</uri>
    </include>

    <include>
      <uri>model://pick_and_place/models/workbench</uri>
      <pose>0.7 0 0.1 0 0 0</pose>
      <static>1</static>
    </include>

    <include>
      <uri>model://pick_and_place/models/underbin_bench</uri>
      <pose>-0.55 0 0.05 0 0 0</pose>
      <static>1</static>
    </include>

    <include>
      <uri>model://pick_and_place/models/bin_red</uri>
      <pose>-0.5 0 0.11 0 0 0</pose>
      <static>1</static>
    </include>

    <include>
      <uri>model://pick_and_place/models/block_red</uri>
      <pose>0.53 0 0.115 0 0 0</pose>
      <name>block_red_target</name>
    </include>

    <model name="openpi_exterior_camera">
      <static>true</static>
      <pose>0.65 -0.25 0.75 0 0.84 2.68</pose>
      <link name="camera_link">
        <visual name="visual">
          <geometry>
            <box>
              <size>0.04 0.04 0.04</size>
            </box>
          </geometry>
          <material>
            <ambient>0.1 0.1 0.1 1</ambient>
            <diffuse>0.1 0.1 0.1 1</diffuse>
          </material>
        </visual>
        <sensor name="camera" type="camera">
          <always_on>true</always_on>
          <visualize>false</visualize>
          <update_rate>20</update_rate>
          <camera>
            <horizontal_fov>1.00</horizontal_fov>
            <image>
              <width>640</width>
              <height>480</height>
              <format>R8G8B8</format>
            </image>
            <clip>
              <near>0.03</near>
              <far>3.0</far>
            </clip>
          </camera>
          <plugin name="openpi_exterior_camera_plugin" filename="libgazebo_ros_camera.so">
            <alwaysOn>true</alwaysOn>
            <updateRate>0.0</updateRate>
            <cameraName>openpi_exterior</cameraName>
            <imageTopicName>/camera/color/image_raw</imageTopicName>
            <cameraInfoTopicName>/camera/color/camera_info</cameraInfoTopicName>
            <frameName>openpi_exterior_camera/camera_link</frameName>
          </plugin>
        </sensor>
      </link>
    </model>

    <gui fullscreen='0'>
      <camera name='user_camera'>
        <pose>0.20 -1.70 1.10 0 0.32 1.57</pose>
        <view_controller>orbit</view_controller>
        <projection_type>perspective</projection_type>
      </camera>
    </gui>
  </world>
</sdf>
